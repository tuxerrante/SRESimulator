# Preferred local runtime file: copy this to `backend/.env.local`.
# The e2e Makefile also falls back to `backend/.env` when `.env.local` is absent.
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
CLUSTER_FLAVOR=aks
AKS_RG=example-aks-rg
AKS_CLUSTER=example-aks-cluster
AKS_FRONTEND_PUBLIC_IP_NAME=example-aks-cluster-aks-frontend-pip
ARO_RG=example-aro-rg
ARO_CLUSTER=example-aro-cluster
AOAI_RG=example-aoai-rg
AOAI_ACCOUNT=example-aoai-account
AOAI_DEPLOYMENT=gpt-5.6-terra
AI_PROVIDER=azure-openai
AI_MOCK_MODE=false
AI_STRICT_STARTUP=true
AI_MODEL=gpt-5.6-terra
AI_AZURE_OPENAI_ENDPOINT=https://example-openai-account.openai.azure.com
AI_AZURE_OPENAI_DEPLOYMENT=gpt-5.6-terra
# Reasoning-capable version for gpt-5.x (accepts reasoning_effort /
# max_completion_tokens). Newest preview available on the ARO SRE tenant.
AI_AZURE_OPENAI_API_VERSION=2025-04-01-preview
AI_AZURE_OPENAI_API_KEY=replace-with-local-secret
# Kubernetes Secret used by Helm to inject frontend auth runtime env vars.
# Keys expected by default: github-client-id, github-client-secret, auth-session-secret
# Non-production GitHub OAuth also requires github-callback-url to contain the
# exact public callback registered for the environment's separate OAuth App.
# Optional keys when anonymous verification is enabled:
# anti-abuse-hmac-secret, turnstile-site-key, turnstile-secret-key,
# turnstile-expected-hostname
GITHUB_AUTH_SECRET_NAME=sre-auth-secrets
GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/github/callback
# Required for signed viewer sessions and live platform-session e2e verification.
AUTH_SESSION_SECRET=replace-with-long-random-session-secret
TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key
TURNSTILE_EXPECTED_HOSTNAME=localhost
# Optional local/e2e bypass. When true, backend accepts any non-empty token.
# Keep false for production.
# TURNSTILE_TEST_MODE=true
ANTI_ABUSE_HMAC_SECRET=replace-with-long-random-anti-abuse-secret
# Deployed public edges enable this after forwarding a verified client IP.
REQUIRE_ANONYMOUS_CLIENT_IP=false
# Required for /api/gameplay/admin and deployed platform-session verification.
GAMEPLAY_ADMIN_TOKEN=replace-with-long-random-gameplay-admin-token
# Optional for automated local/integration traffic classification.
AUTOMATED_TRAFFIC_TOKEN=replace-with-long-random-automated-traffic-token
# Optional local SQL Edge secret for `make dev-db` / `make test-mssql`.
# Keep this only in your untracked local env file; never commit a real value.
# MSSQL_SA_PASSWORD=replace-with-local-sql-sa-password
# Optional explicit MSSQL connection string for `make smoke-backend-mssql` and
# `make test-mssql`. When unset, both targets derive localhost SQL Edge access
# from `MSSQL_SA_PASSWORD`.
# MSSQL_DATABASE_URL=Server=localhost;Database=sresimulator;User Id=sa;Password=replace-with-local-sql-sa-password;TrustServerCertificate=true
TRUST_PROXY_HEADERS=false
# Keep false in production until server-owned scoring is fully deployed.
PERSISTENT_LEADERBOARD_ENABLED=false
# Optional rate limits (requests per minute)
# GAMEPLAY_TELEMETRY_RATE_LIMIT_MAX=60
# GAMEPLAY_ADMIN_RATE_LIMIT_MAX=15
# Optional shared AI limiter settings. Defaults are 15 requests per 60 seconds.
# Set AI_RATE_LIMIT_REDIS_URL in deployed or multi-replica environments so all
# backend pods share one limiter. If Redis is configured but unavailable, the
# AI routes fail open and respond with x-sresim-rate-limit-status: fail-open.
# AI_RATE_LIMIT_MAX=15
# AI_RATE_LIMIT_WINDOW_MS=60000
# AI_RATE_LIMIT_REDIS_URL=redis://localhost:6379/0
# GET /api/ai/budget gets its own, far larger allowance on the same window.
# It is read by every visitor and, behind the frontend proxy, they all share
# one identity, so a per-player cap would hide the banner under ordinary
# traffic. Reading the budget costs no provider quota.
# AI_BUDGET_READ_RATE_LIMIT_MAX=120
# A live probe (GET /api/ai/probe?live=true) is the one read that reaches the
# provider, so it spends the shared budget every player draws on. It needs no
# session and no credential outside production, so its own small cap is what
# stops a loop degrading everyone to simulated answers. Probes answered from
# configuration alone -- mock mode, an unready runtime, live=false -- are not
# counted against it.
# AI_LIVE_PROBE_RATE_LIMIT_MAX=5
# Optional per-route deployment overrides (fall back to AI_AZURE_OPENAI_DEPLOYMENT).
# Command simulation is latency-sensitive (it runs inline during gameplay), so
# point it at a fast model; a mini deployment returns simulated terminal output
# in ~1-2s and keeps the command well under AI_COMMAND_TIMEOUT_MS.
# AI_AZURE_OPENAI_DEPLOYMENT_CHAT=gpt-5.2
# AI_AZURE_OPENAI_DEPLOYMENT_COMMAND=gpt-5-mini
# AI_AZURE_OPENAI_DEPLOYMENT_SCENARIO=gpt-4o-mini
# OpenRouter settings (only read when AI_PROVIDER=openrouter). The key is a
# secret and must never reach a configmap; the model is required too, because
# it is the fallback every route without an override resolves to, so a missing
# one would throw per request instead of refusing to start.
# AI_OPENROUTER_API_KEY=replace-with-local-secret
# AI_OPENROUTER_MODEL=z-ai/glm-5.2:free
# AI_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional per-route model overrides (fall back to AI_OPENROUTER_MODEL). The
# scenario and probe routes fall through to AI_OPENROUTER_MODEL_COMMAND first:
# all three are one-shot calls sharing one free budget, so curating four slugs
# out of a catalogue that churns buys nothing. An explicit override still wins.
# Free slugs come and go -- check https://openrouter.ai/models?q=free rather
# than trusting the placeholders below.
# AI_OPENROUTER_MODEL_CHAT=z-ai/glm-5.2:free
# AI_OPENROUTER_MODEL_COMMAND=vendor/fast-model:free
# AI_OPENROUTER_MODEL_SCENARIO=vendor/fast-model:free
# AI_OPENROUTER_MODEL_PROBE=vendor/fast-model:free
# Optional attribution, sent as HTTP-Referer / X-Title. OpenRouter uses them
# for its public app rankings; both headers are omitted entirely when unset.
# AI_OPENROUTER_SITE_URL=https://sre-simulator.example
# AI_OPENROUTER_APP_TITLE=ARO SRE Simulator
# A spent free-tier budget (HTTP 402, or a 429 carrying a day-scoped cap) is
# answered with simulated output at HTTP 200, labelled
# degradedReason=quota_exhausted, instead of an error that reads as an outage.
# Set false to restore the pre-OpenRouter behaviour everywhere: an exhausted
# budget is then a throttle error like any other.
# AI_DEGRADE_ON_QUOTA_EXHAUSTED=true
# Global AI spend budget, enabled by default only when AI_PROVIDER=openrouter:
# the free tier is capped per *account*, which a per-identity limiter cannot
# see -- one player would otherwise drain a shared daily budget on their own.
# The minute window is charged first, and a request it refuses never charges
# the day. An exhausted day degrades to simulated output by default; set
# AI_GLOBAL_DAILY_EXHAUSTED_MODE=reject to answer 429 instead.
# AI_GLOBAL_BUDGET_ENABLED=true
# AI_GLOBAL_DAILY_MAX is clamped down to the account's own daily limit once one
# has been read, and the clamp only tightens. Until then, on OpenRouter, an
# unset value enforces 50/day -- what an account below 10 lifetime credits is
# allowed -- because the reading comes from a cache that a deployment nobody
# polls never fills. Setting a figure here is a claim about your own account
# and is honoured straight away: set 1000 on a credited account.
# AI_GLOBAL_DAILY_MAX=1000
# AI_GLOBAL_MINUTE_MAX=20
# AI_GLOBAL_DAILY_EXHAUSTED_MODE=degrade
# Unlike the per-identity limiter, an unreadable budget store fails *closed*:
# failing open on a shared account means overspending real money. Affordable
# only because a spent budget stays playable. Set open to invert it.
# AI_GLOBAL_BUDGET_FAIL_MODE=closed
# TTL for the cached GET /api/v1/key lookup behind GET /api/ai/budget.
# AI_OPENROUTER_QUOTA_TTL_MS=60000
# Token budget and reasoning tuning
# AI_REASONING_EFFORT=medium
# Per-route reasoning_effort override (AI_REASONING_EFFORT_<ROUTE>). The command
# route defaults to "low" in code because command simulation is deterministic
# output formatting, not a reasoning task; keeping it low prevents reasoning
# models (gpt-5.x/o-series) from exceeding AI_COMMAND_TIMEOUT_MS and falling back
# to the degraded mock ("Error: timeout"). Override here if you want it higher.
# AI_REASONING_EFFORT_COMMAND=low
# AI_REASONING_EFFORT_CHAT=medium
# AI_REASONING_EFFORT_SCENARIO=medium
# AI_MAX_CHAT_TOKENS=16384
# AI_MAX_COMMAND_TOKENS=8192
# AI_CHAT_TIMEOUT_MS=30000
# AI_COMMAND_TIMEOUT_MS=12000
# AI_SCENARIO_TIMEOUT_MS=12000
# End-to-end application budget for POST /api/scenario, including failure
# cleanup. Clamped to 24000 ms so the application always answers before the
# 30s public gateway timeout. Exhaustion returns 503 with Retry-After, or a
# degraded catalog scenario when only AI generation ran out of budget.
# SCENARIO_REQUEST_BUDGET_MS=24000
# COMPACTION_TOKEN_BUDGET=12000
# COMPACTION_TAIL_MESSAGES=4
