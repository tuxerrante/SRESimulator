# Dependencies
node_modules/

# Environment variables
.env
.env.*
!.env.example
!backend/.env.local.example

# OS files
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Keys and credentials
*.pem
*.key
*.p12

# Build outputs
dist/
build/
out/

# Next.js
.next/
*.tsbuildinfo
next-env.d.ts

# Python
__pycache__/
*.pyc
.venv/
venv/

# Testing
coverage/
test-results/

# Data (leaderboard storage)
data/

# Terraform
infra/.terraform/
infra/.terraform.lock.hcl
infra/.tf-backend.env
infra/.pull-secret.json
infra/tfplan
infra/*.tfstate*
infra/terraform.tfvars
infra/crash.log

# Terraform (OCI free-tier root). The block above hardcodes one directory
# level, so infra/oci/ needs its own entries.
infra/oci/.terraform/
infra/oci/.terraform.lock.hcl
infra/oci/.oci-backend.env
infra/oci/tfplan
infra/oci/*.tfstate*
infra/oci/terraform.tfvars
infra/oci/crash.log
# ci.yml's terraform-validate job writes a local-backend override so
# `terraform console` can render cloud-init without OCI credentials.
infra/oci/*_override.tf

# Worktrees (agent-managed isolated checkouts)
.worktrees/

# Misc
*.tmp
*.bak
