# Copy to terraform.tfvars and fill in your values.
# terraform.tfvars is gitignored - never commit real values.
# For final environment provisioning (aaffinit-test), use
# final-aaffinit-test.tfvars.example as the starting point.

owner_alias = ""  # required - your alias, e.g. "jdoe"
location    = "eastus"

# Cluster platform selector. AKS is the default low-cost path; ARO remains
# available as a fallback.
# cluster_flavor = "aks"

# AKS defaults (small, autoscaled baseline)
# aks_kubernetes_version      = ""                # leave empty for provider default
# aks_node_vm_size            = "Standard_B2s"
# aks_node_count_min          = 1
# aks_node_count_max          = 5
# aks_vnet_address_space      = "10.10.0.0/22"
# aks_node_subnet_cidr        = "10.10.0.0/24"
# aks_service_cidr            = "10.10.4.0/24"
# aks_dns_service_ip          = "10.10.4.10"
# aks_node_resource_group_name = "jdoe-test-aks-nodes"  # optional override
# aks_frontend_public_ip_name  = "jdoe-test-frontend-pip" # optional override for the frontend public IP resource
# aks_public_ip_dns_label     = "jdoe-test"             # optional DNS label for the frontend public IP
# aks_gateway_host                 = "play.sresimulator.osadev.cloud"
# aks_dns_zone_name                = "osadev.cloud"
# aks_dns_zone_resource_group_name = "dns"
# aks_cert_manager_identity_name   = "jdoe-test-cert-manager-dns" # optional override for the cert-manager DNS identity

# ARO fallback settings (used only when cluster_flavor = "aro")
# master_vm_size = "Standard_D8s_v3"   # minimum, cannot go smaller
# worker_vm_size = "Standard_D4s_v3"
# worker_count   = 2

# ARO version - used only for cluster_flavor = "aro"
# Leave empty for latest, or pin to a specific version
# (run: az aro get-versions --location eastus -o table)
# aro_version = "4.17.27"

# Red Hat pull secret (optional but recommended)
# NOTE: Terraform does not expand "~"; use an absolute path.
# pull_secret_path = "/absolute/path/to/pull-secret.txt"

# Azure OpenAI deployment alias and model (the model must be available in the
# selected region and SKU). Keep the alias stable when changing the model.
# aoai_deployment_name = "gpt-5.6-terra"
# aoai_model_name      = "gpt-5.6-terra"
# aoai_model_version   = "2026-07-09"
# aoai_sku_name        = "GlobalStandard"
# aoai_capacity        = 80  # 80K TPM rate limit (pay-per-token, not per capacity)

# Fast deployment for the command route (deterministic CLI/KQL output at
# reasoning_effort=low). Wire the app to it via AOAI_DEPLOYMENT_COMMAND /
# AI_AZURE_OPENAI_DEPLOYMENT_COMMAND (see `terraform output env_file_snippet`).
# Set enable_aoai_command_deployment = false to run all routes on the global
# deployment (not recommended: the command route then times out into a degraded
# mock). gpt-5.4-mini is a newer alternative to the gpt-5-mini default.
# enable_aoai_command_deployment = true
# aoai_command_deployment_name   = "gpt-5-mini"
# aoai_command_model_name        = "gpt-5-mini"
# aoai_command_model_version     = "2025-08-07"
# aoai_command_sku_name          = "GlobalStandard"
# aoai_command_capacity          = 50  # 50K TPM rate limit

# Stable namespace for the app (shared cluster + AOAI with e2e namespaces)
# prod_namespace = "sre-simulator"

# Budget alert – sends email when monthly RG spend reaches threshold
budget_alert_emails = ["your-email@example.com"]
# budget_amount       = 200  # monthly cap in billing currency (default 200)

# Azure SQL Database free tier (persistent leaderboard + sessions, $0/month)
# enable_database    = true
# enable_sql_free_tier = false # set true only where free-tier update is supported
# sql_admin_password = "<strong-password-meeting-azure-complexity>"
# sql_server_name    = "jdoe-test-sql-001" # optional override if default name is unavailable

# Additional tags to apply to all resources
# extra_tags = {
#   team = "your-team"
# }
# Disable only when deny assignments block writes on <alias>-test-cluster-rg.
# enable_cluster_rg_tag_overlay = false
#
# For test-tagged environments, prefer:
# extra_tags = {
#   test = "true"
# }
